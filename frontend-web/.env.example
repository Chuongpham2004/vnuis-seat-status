# All optional. By default the app calls /api and /ws on its own origin
# (Vite dev proxy or the nginx container forward them to backend-core).

# Dev proxy targets (vite.config.js)
# DEV_BACKEND_URL=http://localhost:8080
# DEV_SIMULATOR_URL=http://localhost:8090

# Call a backend on another origin instead (it must allow this origin in CORS_ALLOWED_ORIGINS)
# VITE_API_BASE=http://192.168.1.10:8080
# VITE_WS_URL=ws://192.168.1.10:8080/ws
# VITE_SIMULATOR_BASE=/sim

# Show the one-click demo account buttons on the login page in production builds
# VITE_SHOW_DEMO_ACCOUNTS=true
