# Copy to infra/.env to override the dev defaults in docker-compose.yml.
# Never commit infra/.env.

# ---------- PostgreSQL ----------
POSTGRES_DB=library
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_pw
# Host port 5433: a native Windows PostgreSQL often owns 5432
POSTGRES_PORT=5433
# Read-only role used by ai-service (created on first start of the volume)
AI_DB_PASSWORD=ai_reader_dev_pw

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- EMQX ----------
MQTT_PORT=1883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=library_admin
# MQTT client passwords must match infra/emqx/auth-bootstrap.csv
MQTT_BACKEND_PASSWORD=backend_dev_pw
MQTT_SIMULATOR_PASSWORD=simulator_dev_pw

# ---------- backend-core ----------
BACKEND_PORT=8080
JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes-long
# Set to ",demo" to shrink timers (15m->60s, 30m->90s, 2m->20s, 1m->10s) for live demos
DEMO_PROFILE=

# ---------- ai-service ----------
AI_PORT=8000
# Chat engine. With no key/URL below the built-in deterministic engine is used.
# auto | deterministic | anthropic | openai | gemini | ollama
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# e.g. http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# ---------- iot-simulator / frontend ----------
SIMULATOR_PORT=8090
SIM_SEATS=59
FRONTEND_PORT=5173
